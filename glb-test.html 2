<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>GLB Test</title>
    <style>
        html, body {
            margin: 0;
            width: 100%;
            height: 100%;
            background: black;
            overflow: hidden;
        }
        #status {
            position: absolute;
            top: 10px;
            left: 10px;
            color: #0f0;
            font-family: monospace;
            font-size: 16px;
            z-index: 10;
            white-space: pre-line;
        }
    </style>
</head>
<body>

    <div id="status">Lade...</div>

    <script type="importmap">
    {
        "imports": {
            "three": "https://cdn.jsdelivr.net/npm/three@0.150.0/build/three.module.js"
        }
    }
    </script>

    <script type="module">

        import * as THREE from "three";
        import { GLTFLoader } from "https://cdn.jsdelivr.net/npm/three@0.150.0/examples/jsm/loaders/GLTFLoader.js";
        import { RoomEnvironment } from "https://cdn.jsdelivr.net/npm/three@0.150.0/examples/jsm/environments/RoomEnvironment.js";

        var statusFeld = document.getElementById("status");

        function log(text) {
            statusFeld.textContent += "\n" + text;
            console.log(text);
        }

        log("Schritt 1: Module geladen (THREE + GLTFLoader).");

        var szene = new THREE.Scene();

        var kamera = new THREE.PerspectiveCamera(
            45,
            window.innerWidth / window.innerHeight,
            0.1,
            1000
        );
        kamera.position.set(0, 0, 5);

        var renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        document.body.appendChild(renderer.domElement);

        // Fertige "Raum-Umgebung" von three.js verwenden, damit Chrome-Material
        // etwas Realistisches zum Spiegeln hat (statt einer selbstgebauten Szene).
        var pmrem = new THREE.PMREMGenerator(renderer);
        var umgebungsTextur = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
        szene.environment = umgebungsTextur;
        szene.background = new THREE.Color(0x000000);

        // einfaches Licht, nur damit man ueberhaupt etwas sieht
        var licht1 = new THREE.HemisphereLight(0xffffff, 0x444444, 2);
        szene.add(licht1);

        var licht2 = new THREE.DirectionalLight(0xffffff, 2);
        licht2.position.set(3, 5, 4);
        szene.add(licht2);

        log("Schritt 2: Szene, Kamera, Renderer erstellt.");

        var lader = new GLTFLoader();

        log("Schritt 3: Starte Laden von P-Metallic-6.glb ...");

        var modell = null;

        lader.load(
            "p-metallic.glb",
            function (gltf) {
                log("ERFOLG: GLB wurde geladen.");

                modell = gltf.scene;
                szene.add(modell);

                // Modell automatisch zentrieren und passend skalieren
                var box = new THREE.Box3().setFromObject(modell);
                var groesse = new THREE.Vector3();
                box.getSize(groesse);
                var mitte = new THREE.Vector3();
                box.getCenter(mitte);

                modell.position.sub(mitte);

                var maxSeite = Math.max(groesse.x, groesse.y, groesse.z);
                var skala = 2.5 / maxSeite;
                modell.scale.setScalar(skala);

                log("Groesse vor Skalierung: " + groesse.x.toFixed(2) + " / " + groesse.y.toFixed(2) + " / " + groesse.z.toFixed(2));
                log("Angewendete Skalierung: " + skala.toFixed(4));

                log("--- Material-Details ---");
                modell.traverse(function (kind) {
                    if (kind.isMesh) {
                        var m = kind.material;
                        log("Mesh: " + kind.name);
                        log("  Material-Typ: " + m.type);
                        log("  color: " + (m.color ? m.color.getHexString() : "keine"));
                        log("  metalness: " + m.metalness);
                        log("  roughness: " + m.roughness);
                        log("  hat map (Textur): " + (m.map ? "ja" : "nein"));
                        log("  hat metalnessMap: " + (m.metalnessMap ? "ja" : "nein"));
                        log("  emissive: " + (m.emissive ? m.emissive.getHexString() : "keine"));
                    }
                });
            },
            function (fortschritt) {
                if (fortschritt.total) {
                    var prozent = Math.round((fortschritt.loaded / fortschritt.total) * 100);
                    statusFeld.textContent = "Lade GLB... " + prozent + "%";
                }
            },
            function (fehler) {
                log("FEHLER beim Laden der GLB-Datei:");
                log(String(fehler));
                if (fehler && fehler.message) {
                    log("Fehlermeldung: " + fehler.message);
                }
            }
        );

        function animieren() {
            requestAnimationFrame(animieren);

            if (modell) {
                modell.rotation.y += 0.01;
            }

            renderer.render(szene, kamera);
        }

        animieren();

    </script>

</body>
</html>
